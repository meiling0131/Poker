// One Cloudflare Worker serves both the site and the Verve server:
//   static files from dist/ (npm run build copies index.html, css/, js/, the manifest and icons there)
//   /room/<CODE>  WebSocket to that room's Durable Object (server/worker.js)
//   /rooms        the room list, kept by the Lobby Durable Object (server/lobby.js)
//   /audit        local dev only: checks balances against transactions (server/audit.js)
//   every minute  the day's close at 23:55 Eastern and its cleanup after 00:05 (server/day.js)
// Deploy: push to main (.github/workflows/deploy.yml: lint, tests, build, the database, new migrations,
//   wrangler deploy), or by hand: npm run db:migrate, then npm run deploy
// The D1 database is found by its name, verve, in this account; the workflow creates it if it is missing.
{
  "name": "verve",
  "account_id": "99abcf9b0878a8b932cb0fcc9c9b3140",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "triggers": { "crons": ["* * * * *"] },
  "assets": { "directory": "./dist" },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }, { "name": "LOBBY", "class_name": "Lobby" }] },
  "d1_databases": [{ "binding": "DB", "database_name": "verve", "migrations_dir": "migrations" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["Lobby"] }]
}
