// One Cloudflare Worker serves both the site and the Verve server:
//   static files from dist/ (the deploy workflow copies index.html, css/ and js/ there first)
//   /room/<CODE>  WebSocket to that room's Durable Object (server/worker.js)
// Deploy: push to main (.github/workflows/deploy.yml)
{
  "name": "verve",
  "account_id": "99abcf9b0878a8b932cb0fcc9c9b3140",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "assets": { "directory": "./dist" },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
